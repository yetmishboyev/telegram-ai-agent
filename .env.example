# ============================================================
# TELEGRAM USER API
# https://my.telegram.org/auth → API Development Tools
# ============================================================
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+998901234567
TELEGRAM_SESSION_NAME=shaxzodbek_agent

# ============================================================
# AI PROVIDER — "openai" yoki "anthropic"
# ============================================================
AI_PROVIDER=anthropic
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI model
OPENAI_MODEL=gpt-4o
# Anthropic model
ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql+asyncpg://agent:agent_pass@localhost:5432/telegram_agent
DATABASE_ECHO=false

# docker-compose.yml dagi postgres konteyneri shu qiymatni o'qiydi (${POSTGRES_PASSWORD})
# DATABASE_URL dagi parol bilan bir xil bo'lishi shart
POSTGRES_PASSWORD=change_this_password

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400

# ============================================================
# VECTOR DB (ChromaDB)
# ============================================================
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=agent_memory

# ============================================================
# FASTAPI / DASHBOARD
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-to-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin login uchun
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ============================================================
# AGENT BEHAVIOUR
# ============================================================
AGENT_ENABLED=true
AGENT_MIN_DELAY_SECONDS=2
AGENT_MAX_DELAY_SECONDS=8
AGENT_MAX_CONTEXT_MESSAGES=20
AGENT_SUMMARY_THRESHOLD=50
CONFIDENCE_THRESHOLD=0.7

# ============================================================
# ENVIRONMENT
# ============================================================
ENVIRONMENT=production
LOG_LEVEL=INFO
